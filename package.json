{
  "name": "satsroadmarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.mjs",
    "relay": "node scripts/local-relay.mjs",
    "mint": "bash scripts/local-mint.sh",
    "deploy": "npm run build && wrangler pages deploy dist --project-name satsroadmarket",
    "build:e2e": "VITE_E2E=1 vite build --outDir ${E2E_OUT:-/tmp/satsroad-e2e-dist} --emptyOutDir",
    "preview:e2e": "vite preview --outDir ${E2E_OUT:-/tmp/satsroad-e2e-dist} --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.13.0",
    "@internet-privacy/marmot-ts": "^0.9.0",
    "applesauce-core": "^7.0.3",
    "applesauce-signers": "^7.0.1",
    "localforage": "^1.10.0",
    "nostr-tools": "^2.25.5",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "fake-indexeddb": "^6.2.7",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
